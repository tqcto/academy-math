\newcommand{\splitindent}{\phantom{{}={}}}
\newcounter{CSplitIndent}
\NewDocumentCommand{\spind}{ O{1} }{
  \setcounter{CSplitIndent}{0}
  \whiledo{\value{CSplitIndent}<#1}{
    \splitindent
    \addtocounter{CSplitIndent}{1}
  }
}

